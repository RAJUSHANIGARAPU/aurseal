# Template for a local, git-ignored per-environment file.
#
#   cp config/env/.env.example .env.qa      # repository root, one file per env
#
# The config ladder reads .env.<env> after the real environment and before
# config/environments.json, so anything exported in the shell or by CI wins.
# Every value here is a placeholder: replace it, or delete the line to fall
# through to the committed value. Never commit the copy (.gitignore has .env.*).

# How the run authenticates: none | ui | password | client_credentials | token
AUTH_MODE=REPLACE_ME

# Hosted login page and where the app lands afterwards (default: base_url)
LOGIN_URL=REPLACE_ME
POST_LOGIN_URL=REPLACE_ME

# Test user for ui and password modes
AUTH_USERNAME=REPLACE_ME
AUTH_PASSWORD=REPLACE_ME
AUTH_ORGANIZATION=REPLACE_ME

# Token endpoint and client for password and client_credentials modes
AUTH_TOKEN_URL=REPLACE_ME
AUTH_CLIENT_ID=REPLACE_ME
AUTH_CLIENT_SECRET=REPLACE_ME
AUTH_AUDIENCE=REPLACE_ME
AUTH_SCOPE=REPLACE_ME

# Cookie that carries an opaque session token, when the app uses one
AUTH_TOKEN_COOKIE_NAME=REPLACE_ME

# Run the login browser headless (true/false)
AUTH_HEADLESS=REPLACE_ME

# Server session lifetime in seconds; a cached login older than this is discarded
AUTH_SESSION_TTL_SECONDS=REPLACE_ME

# A bearer token acquired elsewhere, for token mode
SUPPLIED_TOKEN=REPLACE_ME
