{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/v1/member-grant.schema.json",
  "title": "Member grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "role"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,99}$"
    },
    "role": {
      "enum": [
        "viewer",
        "tester",
        "lead",
        "admin"
      ]
    },
    "display_name": {
      "type": "string",
      "maxLength": 200
    }
  }
}
