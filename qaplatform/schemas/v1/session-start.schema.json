{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/v1/session-start.schema.json",
  "title": "Exploratory session start",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "charter"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "charter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "area": {
      "type": "string",
      "maxLength": 200
    },
    "requirements": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"
      }
    },
    "timebox_min": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "release": {
      "type": "string",
      "maxLength": 64
    }
  }
}
