{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/v1/session-end.schema.json",
  "title": "Exploratory session end",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "debrief": {
      "type": "string",
      "maxLength": 20000
    },
    "abandoned": {
      "type": "boolean",
      "default": false
    }
  }
}
