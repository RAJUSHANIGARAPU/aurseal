{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/v1/token-create.schema.json",
  "title": "Token create",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:-]{0,99}$"
    },
    "role": {
      "enum": [
        "viewer",
        "tester",
        "lead",
        "admin"
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 100
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    }
  }
}
