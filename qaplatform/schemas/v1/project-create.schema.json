{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/v1/project-create.schema.json",
  "title": "Project create",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "settings": {
      "type": "object",
      "maxProperties": 50
    }
  }
}
