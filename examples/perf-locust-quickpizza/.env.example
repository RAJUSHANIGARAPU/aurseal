# Copy to .env and adjust. Every setting has a safe default; never commit real secrets.
# Variable names are the Settings fields in src/perf_locust_quickpizza/settings.py, prefixed APP_.
APP_LOG_LEVEL=INFO
APP_TIMEOUT_S=10
# Target of every profile. `make` reads it from the environment or the command line
# (`make load APP_TARGET_URL=http://localhost:3333`); docker compose reads it from here.
APP_TARGET_URL=https://quickpizza.grafana.com
# Load and stress refuse a non-local target. Set to 1 only with the host owner's consent.
# ALLOW_REMOTE_LOAD=1
