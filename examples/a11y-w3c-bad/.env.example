# Copy to .env and adjust. Every setting has a safe default; never commit real secrets.
# Variable names are the Settings fields in src/a11y_w3c_bad/settings.py, prefixed APP_.
APP_LOG_LEVEL=INFO
APP_TIMEOUT_S=10
APP_BASE_URL=https://www.w3.org/WAI/demos/bad
APP_EXPECT_TIMEOUT_MS=5000
# Comma-separated axe tags. WCAG 2.1 AA by default; add wcag22aa for WCAG 2.2.
APP_WCAG_TAGS=wcag2a,wcag2aa,wcag21a,wcag21aa
# Path to a pinned axe.min.js to inject instead of the build axe-playwright-python ships.
APP_AXE_SCRIPT=
