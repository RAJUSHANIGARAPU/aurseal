{
  "suite": "demo-subscription-changes",
  "cases": [
    {
      "id": "CHG-TERMS-1",
      "title": "Agree a new monthly net price",
      "state": "automated",
      "test": "tests/demo_examples/change/test_change_scenarios.py::test_change_case",
      "seen_passing": true,
      "proof": "two green runs in a row of tests/demo_examples/change, 2026-10-17",
      "inputs": {
        "action": "change",
        "ends_in": "active",
        "reasons": [
          "RSN-PRICE-REVIEW"
        ],
        "touches": [
          "monthly_net"
        ],
        "apply": {
          "monthly_net": 52.8
        },
        "then": {
          "price.monthly_net": 52.8
        },
        "origin": "invented"
      }
    },
    {
      "id": "CHG-TERMS-2",
