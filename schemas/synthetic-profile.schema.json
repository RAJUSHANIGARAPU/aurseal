{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthetic-profile.schema.json",
  "title": "Synthetic data constraint profile",
  "type": "object",
  "required": ["entity", "fields"],
  "additionalProperties": false,
  "properties": {
    "entity": {"type": "string", "minLength": 1},
    "endpoint": {"type": ["string", "null"]},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["string", "email", "integer", "number", "boolean", "choice", "date"]},
          "required": {"type": "boolean"},
          "min_len": {"type": "integer", "minimum": 0},
          "max_len": {"type": "integer", "minimum": 0},
          "pattern": {"type": "string"},
          "choices": {"type": "array", "minItems": 1},
          "min": {"type": "number"},
          "max": {"type": "number"}
        }
      }
    }
  }
}
