{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics/metric_shard_run.schema.json",
  "title": "metric_shard_run row",
  "type": "object",
  "required": ["id", "run_id", "created_at", "shard_index", "shard_count", "selected", "executed", "exit_code"],
  "properties": {
    "id": {"type": "string"},
    "run_id": {"type": "string"},
    "nodeid": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "shard_index": {"type": "integer", "minimum": 1},
    "shard_count": {"type": "integer", "minimum": 1},
    "planned_s": {"type": ["number", "null"]},
    "actual_s": {"type": "number"},
    "selected": {"type": "integer", "minimum": 0},
    "executed": {"type": "integer", "minimum": 0},
    "exit_code": {"type": "integer"}
  }
}
