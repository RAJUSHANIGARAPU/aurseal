{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics/metric_synthetic_probe.schema.json",
  "title": "metric_synthetic_probe row",
  "type": "object",
  "required": ["id", "run_id", "created_at", "profile", "mode", "seed", "record_index", "expected", "verdict"],
  "properties": {
    "id": {"type": "string"},
    "run_id": {"type": "string"},
    "nodeid": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "profile": {"type": "string"},
    "mode": {"enum": ["valid", "boundary", "invalid"]},
    "seed": {"type": "integer"},
    "record_index": {"type": "integer", "minimum": 0},
    "strategy": {"type": "string"},
    "broken_constraint": {"type": ["string", "null"]},
    "expected": {"enum": ["accept", "reject"]},
    "observed_status": {"type": ["integer", "null"]},
    "verdict": {"enum": ["pass", "fail", "unreachable"]}
  }
}
