{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/results/junit-import-report-v1.schema.json",
  "title": "JUnit import report",
  "type": "object",
  "required": [
    "run_ids",
    "counts",
    "added",
    "rejected"
  ],
  "properties": {
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "added": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
