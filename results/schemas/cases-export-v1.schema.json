{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/results/cases-export-v1.schema.json",
  "title": "Cases export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_key",
          "title",
          "status",
          "markers",
          "links",
          "steps"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "case_key": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "active",
              "removed"
            ]
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "current_revision_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
