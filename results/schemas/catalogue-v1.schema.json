{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/results/catalogue-v1.schema.json",
  "title": "Test case catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "complete",
    "case_count",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "complete": {
      "type": "boolean",
      "description": "false: a filtered or erroring collection"
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "case_key",
        "title",
        "markers",
        "steps",
        "links",
        "status"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "case_key": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "module": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualname": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ]
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "args": {
                "type": "array"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "status": {
          "enum": [
            "active",
            "removed"
          ]
        },
        "first_seen_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "last_seen_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "current_revision_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
