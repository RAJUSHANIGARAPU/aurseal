  test:
    needs: lint
    runs-on: ubuntu-latest
    timeout-minutes: 20
    # Browsers come from the image, pinned to the Playwright version in pyproject.toml,
    # instead of being downloaded or cached on every run.
    container:
      image: mcr.microsoft.com/playwright/python:v1.58.0-noble
      options: --ipc=host
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v10.2.0
        with:
          python-version: "{{ python_version }}"
      - run: uv sync --locked
      - name: Tests
        run: uv run pytest -n auto -o log_cli=true
      - uses: actions/upload-artifact@v7
        if: {% raw %}${{ !cancelled() }}{% endraw %}
        with:
          name: reports
          path: reports/
          retention-days: 7
