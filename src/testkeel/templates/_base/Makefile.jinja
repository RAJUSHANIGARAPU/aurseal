.DEFAULT_GOAL := help
.PHONY: help install lint fmt typecheck test-offline test smoke report check clean{% if docker %} docker-test{% endif %}{% if type == 'web-ui' %} browsers{% endif %}

PYTEST := uv run pytest

help: ## list the targets
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-14s %s\n", $$1, $$2}'

install: ## create .venv from uv.lock{% if type == 'web-ui' %} and install the browser{% endif %}
	uv sync{% if type == 'web-ui' %}
	$(MAKE) browsers

browsers: ## the Chromium build this Playwright version expects (Linux: add --with-deps)
	uv run playwright install chromium{% endif %}

lint: ## ruff lint + format check
	uv run ruff check .
	uv run ruff format --check .

fmt: ## apply ruff fixes and formatting
	uv run ruff check --fix .
	uv run ruff format .

typecheck: ## mypy, strict on src/
	uv run mypy

test-offline:{% if type == 'web-ui' %} browsers{% endif %} ## tests that need no network access to the target
	$(PYTEST) -m offline

test:{% if type == 'web-ui' %} browsers{% endif %} ## the whole suite, in parallel
	$(PYTEST) -n auto

smoke:{% if type == 'web-ui' %} browsers{% endif %} ## the short live check
	$(PYTEST) -m smoke

report: ## render the report and print where it is
{%- if report in ['allure', 'both'] %}
	allure generate reports/allure-results -o reports/allure-report --clean
	@echo "Allure report: reports/allure-report/index.html"
{%- endif %}
{%- if report in ['html', 'both'] %}
	@echo "HTML report: reports/report.html"
{%- endif %}

check: lint typecheck test-offline ## everything CI checks before the live run
{%- if docker %}

docker-test: ## run the suite in the container
	docker compose run --rm tests
{%- endif %}

clean: ## remove reports and caches
	rm -rf reports test-results .pytest_cache .mypy_cache .ruff_cache
{%- include '_partials/' ~ type ~ '/makefile-targets.part' ignore missing %}
